# Адрес API для веб-предпросмотра на этом же компьютере.
# localhost здесь безопасен: браузер и API работают на одном ноутбуке.
EXPO_PUBLIC_API_BASE_URL_WEB=http://127.0.0.1:8000/api/v1

# Адрес API для Expo Go на iPhone. Укажите IPv4 компьютера в общей частной
# Wi-Fi-сети; localhost на iPhone означает сам телефон и не подойдёт.
# Ключи ИИ, пароли и адрес PostgreSQL здесь запрещены.
EXPO_PUBLIC_API_BASE_URL=

# Только публичный адрес Worker для нативной версии. Это НЕ API-ключ.
# Если пусто, приложение использует опубликованный ur-proect Worker.
EXPO_PUBLIC_ASSISTANT_API_URL=
