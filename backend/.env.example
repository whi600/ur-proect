# Локальная конфигурация сервера. Скопируйте файл в backend/.env и замените
# демонстрационный пароль перед запуском PostgreSQL.
# Этот файл не содержит действительных секретов.

# demo запускается без PostgreSQL. Для работы с подготовленной БД используйте postgres.
APP_DATA_MODE=demo
APP_NAME=ПравоОрбита API

# Нужен только при APP_DATA_MODE=postgres.
APP_DATABASE_URL=postgresql+psycopg://legal_app:change-this-local-only@127.0.0.1:5432/legal_demo

# Будущий интерфейс ИИ. Ключ допускается только в backend/.env и никогда не
# передаётся в мобильное приложение или в EXPO_PUBLIC_* переменные.
APP_AI_PROVIDER=demo
APP_AI_API_KEY=

# Переменные контейнера PostgreSQL. Они нужны Docker Compose, но сервер
# использует APP_DATABASE_URL выше.
POSTGRES_USER=legal_app
POSTGRES_PASSWORD=change-this-local-only
POSTGRES_DB=legal_demo
POSTGRES_PORT=5432
